# ---- Insforge (live backend) ----
# Copy this file to `.env` and fill in YOUR real values (`.env` is gitignored).
INSFORGE_BASE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=ik_your-insforge-api-key-here

# ---- Backend mode ----
# 'insforge' = persist to the live Insforge Postgres (via rawsql API)
# 'memory'   = keep state in-process only (local dev / no credentials)
DB_MODE=insforge

# ---- HTTP server ----
PORT=4000
HOST=0.0.0.0

# ---- App / security ----
APP_NAME=ChessVerse
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars
